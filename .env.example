# Webull OpenAPI credentials.
# Generate these under OpenAPI Management in your Webull account.
# Approval typically takes 1-2 business days.
WEBULL_APP_KEY=your_app_key_here
WEBULL_APP_SECRET=your_app_secret_here

# us | hk | jp
WEBULL_REGION=us

# api.webull.com for production, api.sandbox.webull.com for the test environment
WEBULL_ENDPOINT=api.webull.com
